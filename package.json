{
  "name": "mayor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:draw-layout": "playwright test e2e/draw-layout.spec.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm soul:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "soul:generate": "node --import tsx scripts/generate-soul.ts",
    "soul:check": "node --import tsx scripts/generate-soul.ts --check",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "snapshot:verify": "node --import tsx scripts/verify-snapshot.ts",
    "snapshot:import": "node --import tsx scripts/import-snapshot.ts",
    "artists:build": "node --import tsx scripts/build-artist-catalog.ts",
    "artists:import": "node --import tsx scripts/import-artists.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@photon-ai/chat-adapter-imessage": "3.2.0",
    "@stripe/link-cli": "0.14.0",
    "@vercel/blob": "^2.8.0",
    "chat": "^4",
    "convex": "^1.45.0",
    "h3-js": "^4.1.0",
    "heic-convert": "^2.1.0",
    "next": "16.3.4",
    "ogl": "^1.0.11",
    "openai": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tldraw": "5.4.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "convex-test": "^0.0.56",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "patchedDependencies": {
      "@photon-ai/chat-adapter-imessage@3.2.0": "patches/@photon-ai__chat-adapter-imessage@3.2.0.patch"
    }
  }
}
